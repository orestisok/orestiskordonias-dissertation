# Email (auth emails). Local: Mailpit from compose.yaml, inbox at http://localhost:8025
# Production: any SMTP provider, e.g. smtps://resend:API_KEY@smtp.resend.com:465
SMTP_URL="smtp://localhost:1025"
EMAIL_FROM="CivicScan <no-reply@civicscan.local>"

# Mapbox maps and geocoding (public-issues, submit-report)
PUBLIC_MAPBOX_ACCESS_TOKEN=""

R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# Seed script (npm run db:seed), local only
SEED_STAFF_PASSWORD=""
SEED_CITIZEN_PASSWORD=""
